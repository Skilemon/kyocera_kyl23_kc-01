diff --git a/arch/arm/include/asm/uaccess.h b/arch/arm/include/asm/uaccess.h
index 0a070e98..84b4a2ee 100644
--- a/arch/arm/include/asm/uaccess.h
+++ b/arch/arm/include/asm/uaccess.h
@@ -118,28 +118,28 @@ extern int __get_user_4(void *);
 		: "0" (__p), "r" (__l)					\
 		: __GUP_CLOBBER_##__s)
 
+/*
+ * Range limit: the stock code passed (addr_limit - 1) to the out-of-line
+ * helper, because KERNEL_DS is 0 here and 0 - 1 wraps to "everything".
+ * __range_ok() takes addr_limit verbatim and would reject every kernel
+ * pointer, so the -1 has to be reproduced here.  Valid iff
+ *     addr + sizeof(*p) - 1 <= limit        (no 32-bit wrap)
+ * which is the same as the expression below, overflow-free.
+ */
+#define __kc_user_range_bad(addr,size)					\
+	((addr) > (current_thread_info()->addr_limit - 1) - (size) + 1)
+
 #define get_user(x,p)							\
-	({								\
-		unsigned long __limit = current_thread_info()->addr_limit - 1; \
-		register const typeof(*(p)) __user *__p asm("r0") = (p);\
-		register unsigned long __r2 asm("r2");			\
-		register unsigned long __l asm("r1") = __limit;		\
-		register int __e asm("r0");				\
-		switch (sizeof(*(__p))) {				\
-		case 1:							\
-			__get_user_x(__r2, __p, __e, __l, 1);		\
-			break;						\
-		case 2:							\
-			__get_user_x(__r2, __p, __e, __l, 2);		\
-			break;						\
-		case 4:							\
-			__get_user_x(__r2, __p, __e, __l, 4);		\
-			break;						\
-		default: __e = __get_user_bad(); break;			\
-		}							\
-		x = (typeof(*(p))) __r2;				\
-		__e;							\
-	})
+({									\
+	long __gu_err = 0;						\
+	unsigned long __gu_addr = (unsigned long)(p);			\
+	if (__kc_user_range_bad(__gu_addr, sizeof(*(p)))) {		\
+		(x) = (typeof(*(p)))0;					\
+		__gu_err = -EFAULT;					\
+	} else								\
+		__get_user_err((x), (p), __gu_err);			\
+	__gu_err;							\
+})
 
 extern int __put_user_1(void *, unsigned int);
 extern int __put_user_2(void *, unsigned int);
@@ -156,29 +156,15 @@ extern int __put_user_8(void *, unsigned long long);
 		: "ip", "lr", "cc")
 
 #define put_user(x,p)							\
-	({								\
-		unsigned long __limit = current_thread_info()->addr_limit - 1; \
-		register const typeof(*(p)) __r2 asm("r2") = (x);	\
-		register const typeof(*(p)) __user *__p asm("r0") = (p);\
-		register unsigned long __l asm("r1") = __limit;		\
-		register int __e asm("r0");				\
-		switch (sizeof(*(__p))) {				\
-		case 1:							\
-			__put_user_x(__r2, __p, __e, __l, 1);		\
-			break;						\
-		case 2:							\
-			__put_user_x(__r2, __p, __e, __l, 2);		\
-			break;						\
-		case 4:							\
-			__put_user_x(__r2, __p, __e, __l, 4);		\
-			break;						\
-		case 8:							\
-			__put_user_x(__r2, __p, __e, __l, 8);		\
-			break;						\
-		default: __e = __put_user_bad(); break;			\
-		}							\
-		__e;							\
-	})
+({									\
+	long __pu_err = 0;						\
+	unsigned long __pu_addr = (unsigned long)(p);			\
