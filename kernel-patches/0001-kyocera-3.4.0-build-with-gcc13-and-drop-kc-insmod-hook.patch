diff --git a/include/linux/compiler-gcc13.h b/include/linux/compiler-gcc13.h
new file mode 100644
index 00000000..d575d69b
--- /dev/null
+++ b/include/linux/compiler-gcc13.h
@@ -0,0 +1,51 @@
+#ifndef __LINUX_COMPILER_H
+#error "Please don't include <linux/compiler-gcc13.h> directly, include <linux/compiler.h> instead."
+#endif
+
+/*
+ * GCC 13 support for this 3.4 tree.
+ *
+ * include/linux/compiler-gcc.h ends with
+ *     #include gcc_header(__GNUC__)
+ * which expands to <linux/compiler-gcc13.h>.  Without this file the build
+ * stops on the very first .c file.
+ *
+ * This tree predates GCC_VERSION (4.0 era, everything keyed off
+ * __GNUC_MINOR__), so define it here before using it - otherwise every
+ * #if below evaluates 0 and __noclone / unreachable() silently disappear.
+ */
+#ifndef GCC_VERSION
+#define GCC_VERSION (__GNUC__ * 10000 + __GNUC_MINOR__ * 100 + __GNUC_PATCHLEVEL__)
+#endif
+
+#define __used			__attribute__((__used__))
+#define __must_check		__attribute__((warn_unused_result))
+#define __compiler_offsetof(a, b) __builtin_offsetof(a, b)
+
+/* Mark functions as cold, so unlikely() paths are not laid out inline. */
+#define __cold			__attribute__((__cold__))
+#define __linktime_error(message) __attribute__((__error__(message)))
+
+#if GCC_VERSION >= 40500
+/* Mark a position in code as unreachable. */
+#define unreachable()		__builtin_unreachable()
+
+/* Mark a function definition as prohibited from being cloned. */
+#define __noclone		__attribute__((__noclone__))
+#endif
+
+#if GCC_VERSION >= 40100
+#define __compiletime_object_size(obj) __builtin_object_size(obj, 0)
+#endif
+
+/*
+ * __compiletime_warning / __compiletime_error are deliberately NOT defined.
+ *
+ * With gcc 13 __builtin_constant_p() folds differently than it did in 4.8,
+ * so a few constant-folded ilog2()/BUILD_BUG_ON() sites now reach the
+ * ____ilog2_NaN() stub and __attribute__((error())) turns that into a hard
+ * assembler ".err" in the middle of unrelated .c files (block/scsi_ioctl.c,
+ * fs/fat/dir.c, drivers/input/evdev.c ...).  Leaving the attributes out keeps
+ * compiler.h's empty fallback, which is what this tree expects: those paths
+ * are unreachable at run time anyway.
+ */
diff --git a/kernel/timeconst.pl b/kernel/timeconst.pl
index eb51d76e..04612394 100644
--- a/kernel/timeconst.pl
+++ b/kernel/timeconst.pl
@@ -370,7 +370,7 @@ if ($hz eq '--can') {
 	}
 
 	@val = @{$canned_values{$hz}};
-	if (!defined(@val)) {
