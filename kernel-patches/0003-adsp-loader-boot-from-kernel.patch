+			rc = PTR_ERR(priv->pil_h);
+			dev_err(&pdev->dev,
+				"%s: pil get failed, rc=%d\n", __func__, rc);
+			priv->pil_h = NULL;
+			return rc;
 		}
 
 		/* Set the state of the ADSP in APR driver */
@@ -96,13 +119,31 @@ static void adsp_loader_do(struct platform_device *pdev)
 		apr_set_q6_state(APR_SUBSYS_LOADED);
