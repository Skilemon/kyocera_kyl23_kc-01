 #include <mach/qdsp6v2/apr.h>
 #include <linux/of_device.h>
 #include <linux/sysfs.h>
+#include <linux/workqueue.h>
 
 #define Q6_PIL_GET_DELAY_MS 100
 #define BOOT_CMD 1
 
+/*
+ * Nobody on this port writes /sys/kernel/boot_adsp/boot early enough, and the
+ * userspace attempts that do exist (kcadsp.sh, the early-boot line in the rc)
+ * run after post-fs-data, i.e. at ~6 s, which is the very same moment init
+ * starts audioserver.  Instead of racing the audio stack, try from the kernel:
+ * first attempt once /firmware has had time to be mounted, then retry every
+ * couple of seconds.  Every attempt is logged, so one dump is enough to tell a
+ * missing firmware blob from a refused authentication.
+ */
+#define ADSP_BOOT_FIRST_DELAY	(6 * HZ)
+#define ADSP_BOOT_RETRY_DELAY	(2 * HZ)
+#define ADSP_BOOT_MAX_TRIES	20
+
+static struct delayed_work adsp_boot_work;
+static int adsp_boot_tries;
+
 static ssize_t adsp_boot_store(struct kobject *kobj,
 	struct kobj_attribute *attr,
 	const char *buf, size_t count);
@@ -45,47 +62,53 @@ static struct attribute *attrs[] = {
 
 static struct platform_device *adsp_private;
 
