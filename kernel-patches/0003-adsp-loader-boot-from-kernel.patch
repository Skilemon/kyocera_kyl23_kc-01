+	pr_err("adsp-loader: attempt %d/%d failed, rc=%d\n",
+		adsp_boot_tries, ADSP_BOOT_MAX_TRIES, rc);
+
+	if (adsp_boot_tries < ADSP_BOOT_MAX_TRIES)
+		schedule_delayed_work(&adsp_boot_work, ADSP_BOOT_RETRY_DELAY);
