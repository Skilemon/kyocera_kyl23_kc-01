+/*
+ * finit_module(2): load a module straight from a file descriptor.
+ *
+ * Added in 3.8 as ARM syscall 379; this is the 3.4 backport.  Android's Wi-Fi
+ * HAL stopped going through insmod(8) in 6.0 -- libhardware_legacy's insmod()
+ * is
+ *
+ *     syscall(__NR_finit_module, fd, args, 0);
+ *
+ * so without an entry in sys_call_table every attempt returns ENOSYS, which
+ * the framework logs as
+ *
+ *     finit_module for "/vendor/lib/modules/pronto/pronto_wlan.ko" failed:
+ *     Function not implemented
+ *
+ * and then unloads whatever the early-boot helper had already loaded.
+ *
+ * Upstream has the loader mmap the file and read it in place.  This tree's
+ * load_module() instead insists on a user pointer it can copy_from_user()
+ * from, so read the file into vmalloc and pass that with KERNEL_DS raised,
+ * which is exactly how the old sys_init_module() path treated an mmap'ed
+ * image.  One extra copy of a 2 MB module, once per boot.
+ *
+ * Two deliberate departures from upstream:
+ *
+ *  - flags must be zero.  MODULE_INIT_IGNORE_VERMAGIC would let a module
+ *    built against a different kernel load, and the reason this kernel is
+ *    rebuilt from Kyocera's GPL tree at all is that vermagic has to match the
+ *    stock prebuilts (mmc_protect.ko, kc_wp.ko); nothing on this device
+ *    passes either flag.
+ *
+ *  - -EEXIST is reported as success.  /vendor/bin/kcwifi insmods "wlan"
+ *    during early boot so the driver is up before the framework asks, and the
+ *    framework then loads the same file again.  "Already loaded" is the state
+ *    the caller asked for; returning -EEXIST makes WifiStateMachine tear the
+ *    interface back down.
+ */
+SYSCALL_DEFINE3(finit_module, int, fd, const char __user *, uargs, int, flags)
+{
+	struct file *fp;
+	struct inode *inode;
+	mm_segment_t old_fs;
+	char *buf;
+	unsigned long size;
+	long err;
+
+	if (flags != 0)
+		return -EINVAL;
+
+	if (!capable(CAP_SYS_MODULE) || modules_disabled)
+		return -EPERM;
+
+	fp = fget(fd);
+	if (!fp)
+		return -EBADF;
+
+	inode = fp->f_path.dentry->d_inode;
+	size = inode ? i_size_read(inode) : 0;
+	if (size == 0 || size > 64UL * 1024 * 1024) {
+		err = -EINVAL;
+		goto out_fput;
+	}
+
+	buf = vmalloc(size);
+	if (!buf) {
+		err = -ENOMEM;
+		goto out_fput;
+	}
+
+	err = kernel_read(fp, 0, buf, size);
+	fput(fp);
+	fp = NULL;
+
+	if (err != (long)size) {
+		if (err >= 0)
+			err = -EIO;
+		goto out_free;
+	}
+
+	old_fs = get_fs();
+	set_fs(KERNEL_DS);
+	err = sys_init_module((void __user *)buf, size, uargs);
+	set_fs(old_fs);
+
+	if (err == -EEXIST) {
+		pr_info("%s: module already loaded, reporting success\n",
+			__func__);
+		err = 0;
+	}
+
+out_free:
+	vfree(buf);
+out_fput:
+	if (fp)
+		fput(fp);
+	return err;
+}
