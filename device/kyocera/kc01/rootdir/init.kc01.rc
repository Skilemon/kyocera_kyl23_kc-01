# The USB compositions used to live in init.kc01.usb.rc next to this file.
# Neither file is installed -- see the note in device.mk -- so they were dead
# weight, and the port had no working USB because of it.  The compositions are
# in msm8926-common/rootdir/init.qcom.rc, which is the board init init.rc
# actually imports for both products.  This file stays as reference material
# for a full-ROM bring-up; add the import back if it is ever installed.

on init
    # Platform
    export RO BOOT_HWC

on early-init
    mount debugfs debugfs /sys/kernel/debug

on fs
    mount_all fstab.kc01
    write /sys/devices/platform/msm_sdcc.3/polling 0

on post-fs
    # WiFi firmware loading
    write /sys/module/wlan/parameters/fwpath "sta"

on boot
    # Touch firmware
    chown system system /sys/devices/virtual/input/input0/enable

service qcamerasvr /system/bin/mm-qcamera-daemon
    class late_start
    user camera
    group camera system inet input graphics
