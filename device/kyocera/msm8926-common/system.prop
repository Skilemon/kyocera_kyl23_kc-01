#
# System properties - Kyocera msm8926 family (KC-01 / miraie KYL23)
#
# Values read from the stock 4.4.4 build.prop of this device unless a comment
# says otherwise.  Anything the ROM should keep identical to the factory
# setting is here; anything that describes the new build (fingerprint, version)
# is set by the per-device product makefile.
#

# ------------------------------------------------------------------ display
# The panel is 720x1280 but Kyocera sets 240 dpi, not the 320 that resolution
# usually implies: the UI is deliberately large.  Changing it now would move
# every layout the user is used to, so it stays.
ro.sf.lcd_density=240
persist.hwc.mdpcomp.enable=true

# -------------------------------------------------------------------- audio
# The factory sets fluence to "none" - there is no second microphone to do
# noise suppression with.  Copying a Fluence configuration from another
# msm8226 device here is the fastest way to get silent calls.
ro.qc.sdk.audio.ssr=false
ro.qc.sdk.audio.fluencetype=none
persist.audio.fluence.voicecall=false
persist.audio.fluence.voicerec=false
persist.audio.fluence.speaker=false
persist.audio.handset.mic=analog

# --------------------------------------------------------------------- GPS
# IZAT premium is disabled in the factory image: the licence for it is not on
# this device, and turning it on makes the GPS HAL fail to initialise.
ro.qc.sdk.izat.premium_enabled=0
ro.qc.sdk.izat.service_mask=0x0

# --------------------------------------------------------------- telephony
# 8 = LTE, CDMA and EvDo.  The radio in this device is the au CDMA one, even
# though the system image on it is KC-01's.
ro.telephony.default_network=8
persist.radio.apm_sim_not_pwdn=1

# ------------------------------------------------------------------ dalvik
dalvik.vm.heapsize=256m
dalvik.vm.heapgrowthlimit=96m
dalvik.vm.heapminfree=4m
dalvik.vm.heapstartsize=8m

# ------------------------------------------------------------------- misc
# The 3.4 kernel has no CONFIG_ANDROID_LOW_MEMORY_KILLER hook the ROM can tune,
# so lmkd from AOSP does the job.
ro.config.low_ram=false
