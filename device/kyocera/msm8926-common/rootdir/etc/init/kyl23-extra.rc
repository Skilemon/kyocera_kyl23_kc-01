# ===========================================================================
# kyl23-extra.rc -- board init for the 7.1 port of the Kyocera msm8926.
#
# This file is part of the device tree (system/etc/init/kyl23-extra.rc) and is
# what makes the ROM boot at all: the vendor blob set is 4.4, the framework is
# 7.1, and everything in between is bridged here or in the helpers it starts.
#
# ---------------------------------------------------------------------------
# Bluetooth.  Five layers had to come off one at a time; the full account with
# the original logs is in docs/DEVICE_NOTES.md §15 (the stack) and §16 (the
# address).  What this file does is listed at the end of this block; the notes
# below are only the parts a reader of *this* file needs to not undo them.
#
# Layer 1 (fix48), the HAL.  The 4.4 blob cannot load here at all: it is linked
# against AudioTrack::write(const void*, size_t), and this ROM's libmedia only
# exports the three-argument form Android 6.0 introduced, so dlopen fails in the
# linker before any of its code runs.  The 7.1 HAL was in the image all along
# under /lib/hw and never ran, because 7.1 searches /vendor/lib/hw first.  The
# port therefore uses 7.1's HAL, JNI and libbt-vendor together, all from one
# tree, so the vendor interface struct matches by construction.
#
# Layer 2 (fix49/fix50), the package.  Bluetooth had been disabled in /data
# since fix32; a disabled package is never bound, so no HAL is reached at all.
# See the post-fs-data trigger further down -- it clears the flag before
# PackageManager reads the file, which is the only window where that works.
#
# Layer 3 (fix51), the alarm clock.  With the package enabled the stack finally
# starts -- and aborts in the same second, over and over, once every 1.3 s for
# as long as the switch is on, which is what the UI reports as "Bluetooth Share
# keeps stopping":
#
#     E bt_osi_alarm: timer_create_internal unable to create timer with
#                     clock 9: Invalid argument
#     E bt_osi_alarm: The kernel might not have support for
#                     timer_create(CLOCK_BOOTTIME_ALARM)
#     F libc: system/bt/osi/./src/alarm.c:157: alarm_new_internal:
#             assertion "false" failed
#     F libc: Fatal signal 6 (SIGABRT) in tid ... (stack_manager)
#
# Clock 9 is CLOCK_BOOTTIME_ALARM.  This device's 3.4 kernel was built without
# the alarm clocks (they arrive with CONFIG_RTC_CLASS), so timer_create()
# rejects the id with EINVAL, alarm_new_internal() hits its assert, and the
# process dies before a single HCI command is ever sent.  Nothing about the
# radio has been tested yet.
#
# The repair is two bytes in the HAL.  timer_create_internal() keeps its
# clock_id argument in r4 and hands it straight to timer_create(); at 0x10145c
#
#       04 46   mov  r4, r0     ->     07 24   movs  r4, #7
#
# so everything the stack schedules is created on CLOCK_BOOTTIME, which every
# kernel since 3.x provides.  The only property given up is waking the device
# out of suspend -- this port does not suspend -- and no other timing call in
# the library is touched: all 22 clock_gettime() sites already use 7, 1 or 0,
# 9 appears exactly once in the whole file, at this call.  Patched HAL md5
# 4ee10c46..., previously c28859f5..., installed at /lib/hw and /vendor/lib/hw.
#
# Layer 4 (fix52), the transport.  With the abort gone the stack got all the way
# down to it and stopped again -- but at least it said why:
#
#     I bt_hci_h4 : hal_open
#     I bt_vendor : bt-vendor : BT_VND_OP_USERIAL_OPEN
#     I bt_vendor : Done intiailizing UART
#     E bt_hci_h4 : hal_open opened the wrong number of ports: got 2, expected 1.
#     I bt_hci_h4 : hal_close
#     E bt_hci_h4 : In transmit_data, error writing to the uart serial port: Bad file descriptor
#     E BluetoothAdapterState: Error enabling Bluetooth (enable timeout)
#
# "got 2, expected 1" is the whole bug, and it is not about Bluetooth at all: it
# is two halves of the stack disagreeing about which transport this phone has.
#
# The vendor library in /vendor/lib is the Qualcomm one for this SoC.  It opens
# two descriptors, /dev/smd3 and /dev/smd2 -- the shared-memory channels to the
# WCNSS's own Bluetooth core, commands on one and ACL/events on the other:
#
#     bt_hci_init_transport()  ->  fd[0] = /dev/smd3, fd[1] = /dev/smd2  -> return 2
#
# bluetooth.default.so carries two HCI back ends and picks one at startup:
#
#     soc_type = get_soc_type();
#     if (soc_type == BT_SOC_ROME || BT_SOC_CHEROKEE
#             || soc_type == BT_SOC_AR3K || soc_type == BT_SOC_DEFAULT)
#         return hci_hal_h4_get_interface();      // ONE descriptor, UART
#     else
#         return hci_hal_mct_get_interface();     // 2 or 4 descriptors, SMD
#
# and get_soc_type() reads qcom.bluetooth.soc, with this table in the library:
#
#     1 "smd"      2 "ath3k"      3 "rome"      4 "cherokee"
#
# The property was never set, so the stack took BT_SOC_DEFAULT, got the UART
# back end, and that back end refuses two descriptors by construction.  Nothing
# was broken; the phone's actual transport was never selected.  It could not
# have worked with any amount of HAL patching, because H4 reads events from the
# same descriptor it writes commands to, and this hardware delivers them on a
# different one.
#
# fix52 sets qcom.bluetooth.soc=smd at post-fs-data.  One property, read by both
# halves (the vendor library reads the same key, and answers "Unknown soc type"
# for "smd" exactly as it already answers for unset -- its behaviour is keyed on
# its own enum default either way, so nothing changes on that side), and the
# stack then picks the MCT back end, which is the one written for two
# descriptors.  See the post-fs-data trigger below.
#
# fix52 worked: the stack opened /dev/smd3 for command-and-event and /dev/smd2
# for ACL, the controller answered, the adapter reached state 12 with
# "Scan Mode:21", it paired, it sent a file, it survived a toggle and a reboot.
#
# One thing was still wrong, and only the *other* end showed it: the address
# this phone advertises is 00:00:00:00:5A:AD.  Not a bad read -- a real one, on
# air and in the stack's own log -- because the controller's NV has never been
# programmed:
#
#     W bt_btif: BTIF init BDA was c4:21:c8:f2:9f:3a
#     W bt_btif: Controller BDA is 00:00:00:00:5a:ad
#
# /persist/.bt_nv.bin *does* hold the right one; a boot that never opened the
# transport says so plainly ("Read the Vendor BD addr from '/persist/.bt_nv.bin'"
# -> Address is:C4:21:C8:F2:9F:3A).  The host simply has no code that pushes it
# into the core.  The 4.4 ROM did, and it is still on the stock image:
#
#     /system/bin/btnvtool         writes NV447 into /persist/.bt_nv.bin
#     /system/bin/hci_qcomm_init   reads NV447 and performs the "NV VS set"
#                                  exchange, which is what programs the
#                                  controller
#     /system/etc/init.qcom.bt.sh  the glue that calls both
#
# Layer 5 (fix53), the address.  7.1's vendor library still performs the same
# handshake it always did: on power-up it sets bluetooth.hciattach=true and
# waits (up to five seconds) for bluetooth.status.  Nothing reacted on this
# port, so that wait simply timed out -- see the five-second gap between
# BT_VND_OP_POWER_CTRL and hal_open in the fix52 log.  fix53 ships the two
# binaries plus a small script of our own (kcbtinit.sh) that runs
# hci_qcomm_init inside that window.  init.qcom.bt.sh itself is *not* used: its
# config_bt() sets a page of ro.qualcomm.bluetooth.* profile flags that would
# change which profiles 7.1 exposes, and none of that is needed to write an
# address.
#
# hci_qcomm_init takes a fallback port from ro.qualcomm.bt.hci_transport (unset
# means /dev/ttyHS0, a UART this phone does not have), and post-fs-data sets it
# to "smd".  In practice -e mode never opens that port: it hands the address to
# the controller over QMI and prints the tty path only as a label.  The verified
# run ends with
#
#     KCBTINIT programmed address=c4:21:c8:f2:9f:3a device=/dev/ttyHS0
#
# and the stack log afterwards says "Controller BDA is c4:21:c8:f2:9f:3a".
# That second line is the one to check on any future boot; the
# "BTIF init BDA was 00:00:00:00:5a:ad" above it is the read taken before the
# write and is expected to stay.  Details in docs/DEVICE_NOTES.md §16.5.
# ---------------------------------------------------------------------------
# Wi-Fi: finished, and this is the shape it ended in.
#
# The device shipped a 4.4 wpa_supplicant (v2.1-devel) that speaks the old
# ctrl_iface dialect, so several rounds of work went into making a 7.1
# framework talk to it -- including a patch to /system/framework/wifi-service.jar
# that made WifiNative.listNetworks() drop the LAST_ID argument, because the
# 4.4 binary answered UNKNOWN COMMAND to it.
#
# That patch was the bug.  WifiConfigStore.loadNetworks() pages through the
# network list and stops when a page holds nothing but the header; with the
# argument gone, "page two" is page one again, the same configKey shows up
# twice, the duplicate branch calls removeNetwork() on the entry it just read,
# and the saved network is deleted on every Wi-Fi toggle.  Settings kept
# showing the AP, the supplicant no longer had it, every SET_NETWORK after that
# answered FAIL, and the next toggle wrote an empty config -- the password
# prompt.
#
# The fix is not another patch.  /system/bin/wpa_supplicant is now built from
# cm-14.1's own external/wpa_supplicant_8 (v2.6-devel), which pages correctly:
# LIST_NETWORKS LAST_ID=-1 returns everything, LAST_ID=<last id> returns the
# header alone, and the loop terminates the way it was written to.  With that
# in place the framework's own wifi-service.jar works untouched, so the jar in
# this build is the unmodified one the build system produced, and nothing
# anywhere writes wpa_supplicant.conf or networkHistory.txt.
#
# What that removed: kcwpa (the 4.4 supplicant wrapper), the 4.4 blob itself,
# /vendor/lib/kcssl, kcwifi2.sh / kcwifi3.sh / kcwifiwd.sh (all three rewrote
# the conf file behind the framework's back), kcwpad, and the jar patch.  What
# stayed: kcwifi, which is what loads the prima driver in the first place.
# ---------------------------------------------------------------------------
#
# The blobs themselves: they were linked against 4.4's bionic/libcutils/
# libmedia, which exported symbols 7.1 dropped (ioprio_set, list_add_tail, the
# two-argument AudioTrack::write, CameraParameters::KEY_BLINK_DETECT, ...).
# Every consumer died at dlopen with "cannot locate symbol", which is why
# rmt_storage (no modem EFS -> unknown baseband), audio.primary (no sound),
# camera.msm8226 (no camera app) and bluetooth.default never worked.
# /vendor/lib/libkccabi.so back-fills all of them at once, so it is preloaded
# into everything init spawns from here on.  It is built with -nostdlib: no
# NEEDED entries, no constructors, nothing that can fail.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# kyl23: 7.1 framework on top of a 4.4 vendor blob set.
#
# The vendor blobs were linked against 4.4's bionic/libcutils/libmedia, which
# exported symbols 7.1 dropped (ioprio_set, list_add_tail, the two-argument
# AudioTrack::write, CameraParameters::KEY_BLINK_DETECT, ...).  Every consumer
# died at dlopen with "cannot locate symbol", which is why rmt_storage (no
# modem EFS -> unknown baseband), audio.primary (no sound), camera.msm8226 (no
# camera app) and bluetooth.default never worked.  /vendor/lib/libkccabi.so
# back-fills all of them at once, so it is preloaded into everything init
# spawns from here on.  It is built with -nostdlib: no NEEDED entries, no
# constructors, nothing that can fail.
# ---------------------------------------------------------------------------

on boot
    setprop wifi.interface wlan0

# ---------------------------------------------------------------------------
# Modem remote filesystem.  rfs_access serves the modem's EFS requests
# (modemst1/2 + fsg).  Without it the firmware stalls during init and its own
# watchdog resets it, and Android shows an unknown baseband.
# ---------------------------------------------------------------------------
service rfs_access /vendor/bin/rfs_access
    class core
    user system
    group system net_raw

# ---------------------------------------------------------------------------
# WiFi.
#
# prima is a "satellite" driver: it cannot bring wlan0 up until wcnss_service
# has fed WCNSS_cfg.dat to the chip over /dev/wcnss_wlan.  The load itself has
# to go through init_module(2), because 7.1's libhardware_legacy (and toybox
# insmod) use finit_module(2), which arrived in Linux 3.8 and this kernel is
# 3.4.  libkccabi makes finit_module() report success; kcwifi does the real
# load and retries until wlan0 exists, so a chip that comes up late still ends
# up working instead of leaving wifi dead for the session.
# ---------------------------------------------------------------------------
service kcwifi /vendor/bin/kcwifi
    seclabel u:r:init:s0
    class core
    user root
    group root system wifi net_raw

# ---------------------------------------------------------------------------
# fix33: WiFi reconnect and the Bluetooth crash loop.
#
# After an off/on cycle the supplicant is a fresh process that, unlike at boot,
# does not select the saved network by itself -- and the framework cannot ask
# it to, because it never adopted that network (it rebuilds it with a made-up
# netId, does not find it in its own list, and drops it:
# "configuration found for missing network, nid=-1616136200, ignored,
# networks.size=1"; -1616136200 is "K2"WPA_PSK.hashCode()).  So the phone scans
# and scans and never joins.  kcwpad is the missing peer: it talks wpa_ctrl on
# /data/misc/wifi/sockets/wlan0 -- the build has no wpa_cli -- and sends
# RECONNECT when the supplicant has been sitting disconnected with an enabled
# network.  It also keeps the conf file itself from being eaten, and disables
# the com.android.bluetooth package, whose 4.4 vendor stack cannot survive the
# 7.1 framework and otherwise SIGSEGVs every 0.7 s.
#
# fix34 turned it from "started, logged four lines, then silence" into a
# daemon that says what it sees on every poll (state, scan result count,
# network list, and the exact step that failed if the ctrl socket is not
# reachable), because last round it was impossible to tell "there was nothing
# to do" from "it gave up".  On top of the kick it now:
#   * strips bssid= from the saved block -- a bssid pin plus a firmware reload
#     (the framework reloads the radio on every enable) means the supplicant
#     scans but can never select a BSS;
#   * pushes the saved network back into a live supplicant that has none
#     (ADD_NETWORK/SET_NETWORK/ENABLE_NETWORK), which is the case that ends in
#     "input the password again";
#   * creates /dev/kmsg when the image has none, so kernel-log breadcrumbs
#     exist even if /cache is truncated.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# fix40: kcwpad is retired.
#
# It did the right thing in the wrong place.  Its job was to put the saved
# network back when the supplicant came up without one, but it wrote the conf
# *file*, and a running supplicant never re-reads that file -- so after an
# off/on cycle it restored the file while the live process kept an empty
# configuration, the framework kept aiming SET_NETWORK at network id 0, the
# blob answered FAIL, CMD_AUTO_CONNECT gave up with "couldn't update the
# config, got null config", and the phone scanned forever without joining.
# Its own log said as much: "ctrl open failed (connect:Connection refused)".
#
# kcwd talks to the running process instead, over the interface control socket
# /data/misc/wifi/sockets/wlan0 (4.4 style, bare commands) and, failing that,
# the abstract name wpa_wlan0 that the 7.1 framework uses.  When LIST_NETWORKS
# comes back with no rows it recreates the saved network with ADD_NETWORK /
# SET_NETWORK / ENABLE_NETWORK / SAVE_CONFIG, which repairs the live process
# *and* the file in one step.  It stays out of the way otherwise: it only acts
# when the supplicant has no networks at all, so it never fights the framework
# over a network the user actually has, and it keeps /data/misc/wifi/kc_wpa.gold
# as the last known good copy.
#
# service kcwpad /vendor/bin/kcwpad
#     class late_start
#     user root
#     group root system wifi

# ---------------------------------------------------------------------------
# fix43: kcwd is gone, and so is the 4.4 supplicant.
#
# Everything above this line was written to keep a 4.4 wpa_supplicant blob
# alive under a 7.1 framework: kcwpad talked to it, kcwd repaired its config
# file, the framework's jar was patched so LIST_NETWORKS would be understood.
# The real fix is the one the device should have shipped with -- /system/bin
# wpa_supplicant, built from cm-14.1's own external/wpa_supplicant_8, which
# speaks the ctrl_iface dialect the framework expects.  With it in place the
# network ids agree, SAVE_CONFIG stores a real config, and the saved network
# survives an off/on cycle without any help.
#
# So: no daemon, no file repair, no jar patch.  See the p2p_supplicant
# service below for the one line that changed.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# WiFi, part two: the framework's half.
#
# fix29 proved the config side was fine -- /data/misc/wifi/wpa_supplicant.conf
# carries psk= and update_config=1 -- and the phone still refused to reconnect
# after a single off/on cycle.  logcat says why, twice:
#
#     WifiMonitor: killSupplicant p2ptrue init.svc.wpa_supplicant=unknown
#     WifiStateMachine: Failed to load driver
#
# "Failed to load driver" is 7.1's libhardware_legacy/wifi.c asking for the
# module: is_wifi_driver_loaded() looks at /proc/modules *and* at the property
# wlan.driver.status, and when that check misses it calls insmod(), which uses
# finit_module(2).  This kernel is 3.4; finit_module does not exist, so insmod
# fails in two milliseconds and the whole wifi stack stops before it ever
# reaches the supplicant -- no supplicant, no config, no saved networks, which
# is the "it forgot my password again" screen.
#
# wlan0 is already up at that point: wlan_up.sh loaded prima with
# init_module(2) at 10 s and set wlan.driver.status=ok.  The framework is
# arguing about a module it does not need to load.
#
# So wifi_load_driver() and wifi_unload_driver() in /lib/libhardware_legacy.so
# are patched to "movs r0,#0 ; bx lr" -- report success, touch nothing.  The
# interface then comes up once per boot (wlan_up.sh) and stays up for the life
# of the boot: turning wifi off stops the supplicant, turning it on starts a new
# one against a live wlan0, and the saved network is there every time.
#
# kcwifiwd is the insurance: if wlan0 ever does disappear, reload it.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# WiFi, part three: keep the saved network on disk for the whole session.
#
# fix31 made the file correct at boot and the phone now joins K2 by itself
# after a cold start -- but not after a WiFi off/on cycle, and the password has
# to be typed again every time.  The dump finally shows why, and it is not the
# supplicant's fault:
#
#     WifiConfigManager: Loading config and enabling all networks
#     WifiConfigManager: configuration found for missing network,
#                        nid=-1616136200, ignored, networks.size=1
#
# -1616136200 is Java's "K2"WPA_PSK.hashCode(): the framework rebuilds the
# network from the file, gets a made-up netId instead of the supplicant's 0,
# throws it away, and therefore holds *zero* configured networks for the whole
# boot.  WiFi still works at boot because the supplicant joins a network it
# already has without asking the framework.
#
# Turning WiFi off is where that empty list becomes data loss.
# WifiConfigStore.saveConfig() begins by calling removeNetwork() for every
# netId the supplicant has and the framework does not know about, then saves.
# With an empty list that is "remove the only network, then save the empty
# result" -- the psk is deleted from /data/misc/wifi/wpa_supplicant.conf, not
# merely forgotten.  Turning WiFi back on starts a supplicant with no networks
# at all, Settings asks for the password (ID: -1, hasEverConnected: false), and
# each entry deposits one more disabled=1 copy of K2 -- the file grew from 1
# block to 4 in a single session.
#
# kcwifi3 keeps a copy of the healthy file (one block, psk=, no disabled=1) in
# /data/misc/wifi/kc_wpa.gold and in /cache, and puts it back the moment the
# file loses it, which is while WiFi is still off -- so the next supplicant
# start is byte for byte the one that auto-joins after a reboot.  If the file
# comes back with duplicates, it collapses them per SSID.  After a repair it
# sends SIGHUP to the supplicant, which it treats as "reconfigure": the repair
# also takes effect when WiFi is already on, without wpa_cli (there is none on
# this build).  See kcwifi3.sh.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Bluetooth: stop the crash loop.
#
# HISTORICAL -- fix48 replaced the 4.4 HAL with the 7.1 one and reverted the
# JNI patches described below, so none of this is in effect any more.  It is
# kept because it is the clearest record of what the blob/framework mismatch
# actually looked like, and because the "reverting this one patch brings the
# crashes back" line is still the right warning for anyone tempted to put the
# 4.4 HAL back.
#
# The kernel's user-fault reporter finally caught the crash this time:
#
#     USRFLT BluetoothAdapte/3667 addr=0000003c fsr=00005
#     USRFLT pc ... bluetooth.default.so off=000343f2 (ldr r2,[r4,#0x3c], r4=0)
#
# bluetooth.default.so dereferences a NULL callback struct 0x3c bytes in -- the
# 7.1 framework hands the 4.4 vendor stack a bt_callbacks_t of the wrong shape,
# the guard before it passes, and the stack walks off the end of the struct.
# Same root as everything else on this port: the blobs predate the framework.
# It crashes, the framework restarts AdapterService, it crashes again: 100 times
# in four minutes, each one spawning debuggerd, and that storm is why a 1 MB
# logcat only held 75 seconds and why the UI stutters.
#
# btif_init_bluetooth is patched to return BT_STATUS_NOT_READY immediately, so
# the stack never gets far enough to walk off the struct: AdapterService sees
# initNative fail and stays off, quietly, with no crash and no restart loop.
# Bluetooth still cannot be turned on -- the WCNSS BT core never comes up on
# this port -- but it no longer costs the rest of the phone anything.
# Reverting this one 4-byte patch brings the crashes back.
#
# fix31: that was only half of it.  The stack still crashed every 1.3 s, and
# the kernel's fault reporter said why -- JNI wrappers hand the HAL's
# bt_status_t back as if it were a pointer:
#
#     libbluetooth_jni.so off=00015b82, 00016416, and then 0001481c
#
# Each is an `ldr r1,[r0,#4]` / `blx r1` pair that runs when the status is not
# zero, i.e. it dereferences 2 (BT_STATUS_NOT_READY) as an address and faults
# at 0x6.  fix26 patched the first one at a wrong offset, fix27 patched the
# second and the crash moved back to the first, fix31 patched both and the
# crash moved to a third: whack-a-mole, because the whole file is built from
# one template.
#
# fix32 stops playing that game.  The template is
#
#     ldr rX,[iface,#0x58] ; blx rX ; cmp r0,#0 ; str r0,[global] ; beq err
#     ldr rY,[r0,#4] ; blx rY
#
# -- 7.1's slot 0x58 is get_profile_interface, but the 4.4 vendor library has a
# different table layout, so 0x58 is a function that returns a bt_status_t and
# the JNI dereferences 2 as if it were a profile struct.  All eleven copies of
# that template are patched (the beq before each dereference becomes an
# unconditional branch), so the status is logged and the call returns instead
# of faulting.  Even with a correct offset the seven-year-old profile structs
# behind it would not survive contact with the 7.1 callbacks, so Bluetooth
# stays off -- but it stays off quietly: the session before this one restarted
# AdapterService ~380 times in seven minutes.
# ---------------------------------------------------------------------------

service kcssr /vendor/bin/kcssr.sh
    seclabel u:r:init:s0
    class core
    user root
    group root system
    oneshot

# Stock boots the ADSP from init.qcom.rc, one line, on early-boot:
#
#     write /sys/kernel/boot_adsp/boot 1
#
# Two measured facts, and one correction of what this file said in fix66/67:
#
#   1. The trigger has to happen before init starts audioserver, which is at
#      6.06 s (class_start main).  pil_boot() then takes ~0.5 s (load 5.516 ->
#      "Q6 Is Up" 6.020 in the boot that worked), so anything later than ~5.5 s
#      loses the race.
#   2. early-boot is *after* post-fs-data, i.e. 5.99 s here, and it lost: fix66
#      wrote there and the log shows no pil_boot() at all (no "loading from",
#      no "Q6/ADSP image is loaded").  post-fs-data starts at 4.70 s, half a
#      second after /firmware -- where adsp.mdt lives -- is mounted at 4.688,
#      so that is the earliest hook that can work, and it leaves ~1.3 s of
#      margin instead of -0.1 s.
#
# The write is synchronous: init blocks in request_firmware() for the ~0.5 s
# the load takes.  That is the point -- init is blocked, so audioserver starts
# later, while the ADSP comes up earlier.
#
# If this ever hangs the boot instead (no /firmware, corrupt blob), the log
# will stop right after "on post-fs-data" and the fix is to drop that line and
# let the kernel retry (kernel-patches/0003, first attempt 5 s, every 1 s, 60
# tries) do it alone.  The two are safe together: subsystem_get() is
# refcounted and adsp_loader_do() returns early once the ADSP is up.
#
# The line itself is the first action of the post-fs-data section further down.

# kcadsp is the only thing on this device that runs as root without adb, so it
# carries three jobs now.  In order:
#
#   1. ask for the ADSP again (every 2 s, up to 20 s) and record every attempt,
#      for a kernel without patch 0003 -- subsystem_get() is refcounted, so this
#      is safe next to the post-fs-data write;
#   2. bring USB up itself.  The framework writes sys.usb.config and every value
#      it can write has a stanza in init.qcom.rc, but the stanzas were never the
#      problem: this kernel's android.c silently ignores enable_store(1) while
#      serial_string is still the built-in "0123456789ABCDEF" (android.c:2724),
#      and only the factory ramdisk's `service usb_init /vendor/bin/usb_init`
#      (init.rc:676) ever wrote iSerial.  Our ramdisk has no usb_init, so enable
#      has been 0 since the day init.rc was replaced -- no pull-up, no device on
#      the host at all, which is exactly what "nothing happens when I plug it
#      in" means.  The script writes iSerial from the eMMC CID, then enables;
#   3. leave a report and sample once a second for 30 minutes;
#   4. the moment a PCM node goes busy, snapshot AudioFlinger while the stream
#      is live -- fix72 opened and closed the output in 3.4 s and a 2 s sampler
#      could only say "we did not see RUNNING".
#
# The report goes to /data/local/tmp/kcaudio.txt (0644) and as KCRPT lines into
# /dev/kmsg.  fix77 dropped the /data/media/0 and /cache copies: the media copy
# only existed so that a file manager or MTP could read it, and what it actually
# did was put a second identical file in every dump handed over for inspection.
service kcadsp /vendor/bin/kcadsp.sh
    seclabel u:r:init:s0
    class core
    user root
    group root system
    oneshot

# Started a second time once the framework is up: the copy from class core may
# have arrived before /data was ready to take a file.  The script holds a pid
# file, so the second start is a no-op when the first one is still sampling.
on property:sys.boot_completed=1
    start kcadsp

# Pocket mode, once the framework is up: before boot_completed the sensor node
# may not have been chowned by kcsensor yet and there is nothing for the daemon
# to watch anyway (no screen to switch off).
on property:sys.boot_completed=1
    start kcprox

# Continuous logcat, from boot_completed until the phone is switched off.
#
# fix72's report carried a 20-second playback window and eight logcat lines,
# every one of them from the boot.  `logcat -d -t 400` ran once, at 74 s, and
# 400 lines of a busy 7.1 boot do not reach 60 s forward; by the time the user
# pressed play the instrument had already stopped recording.  The ring buffer
# is the wrong tool for "what happened when I pressed play" anyway -- the
# player, AudioFlinger, the codec and the HAL all log there and all of it is
# overwritten within a minute.
#
# So: to a file, rotated, in /data/local/tmp, which recovery can pull with adb
# while /data is mounted.  -b main,system,crash,radio and not "all": the kernel
# buffer is dmesg (already dumped into the report) and the events buffer is
# audit spam (the same dump's log partition is half audit_lost lines).
#
# Cost: one long-lived logcat process, 8 MB of turnover.  That is acceptable
# for a build whose whole purpose is to be observed.
service kclogcat /system/bin/logcat -b main,system,crash,radio -v threadtime -f /data/local/tmp/kclogcat.txt -r 4096 -n 2
    class core
    user root
    group root system log
    disabled

on property:sys.boot_completed=1
    start kclogcat

# kcbtnled is gone (fix80); see the note where its service used to be.
# Bluetooth package state: clear the flag before PackageManager reads it.
#
# fix32's wpa hook ran `pm disable com.android.bluetooth` to stop the 4.4 crash
# loop.  The flag is not in any system image; it is in
# /data/system/users/0/package-restrictions.xml, so it survived every build
# since.  A package disabled for the user is not "an adapter that fails to
# open".  Every one of its services becomes unresolvable, so
# BluetoothManagerService.enable() dies inside bindService() before a process
# is started and before a HAL is loaded:
#
#     D BluetoothManagerService: enable(com.android.settings): mState = OFF
#     D BluetoothManagerService: MESSAGE_ENABLE(0): mBluetooth = null
#     E BluetoothManagerService: Fail to bind to:
#            Intent { act=android.bluetooth.IBluetooth }
#
# with no "Start proc ... com.android.bluetooth" afterwards anywhere in the
# boot, and the profile services failing the same way from the Settings
# process.  Compare a boot from before fix32, where the same line is followed
# by "Start proc 13026:com.android.bluetooth/1002 for service ...AdapterService".
#
# fix49 tried to clear it with `pm default-state` at boot_completed.  Right
# idea, wrong clock.  `pm` is a shell wrapper around app_process, and the first
# one of those costs close to a minute on this device while the boot is still
# settling.  Measured on the fix49 boot:
#
#     boot_completed            05:12:47
#     first pm process visible  05:13:51
#     toggle tried by hand      05:13:58   -> still "Fail to bind"
#
# Four seconds after the first pm had even started.  Nothing was broken; the
# repair had not reached the flag yet.
#
# So fix50 does not ask PackageManager to change its mind, it changes the file
# PackageManager reads, and it does it at post-fs-data: before zygote, before
# system_server, before PackageManagerService parses that file.  The edit is
# then in force for the whole boot with no pm, no binder, nothing to wait for.
# kcbt.sh rewrites exactly one package's state flags (enabled, inst, stopped,
# hidden) and leaves the rest of the file byte for byte, writing back through
# `cat >` so the inode, owner, mode and SELinux label of the original survive.
#
# The boot_completed pass stays as a fallback for the case where post-fs-data
# ran before /data was readable; it re-reads the file, and only if something is
# still off does it fall back to `pm`, twice at most.
on property:sys.boot_completed=1
    exec -- /system/etc/kcbt.sh post

# ---------------------------------------------------------------------------
# Bluetooth core bring-up: the address the controller does not have.
#
# 7.1's vendor library hands the transport to init the same way the 4.4 one did
# -- property bluetooth.hciattach=true, then a wait of at most five seconds for
# bluetooth.status -- and on stock that was the cue to run hci_qcomm_init over
# /dev/smd3, which is the only thing that programs the WCNSS Bluetooth core's
# NV (BD_ADDR, reference clock, clock sharing).  Without it the core answers
# HCI_Read_BD_ADDR with 00:00:00:00:5A:AD: everything works except the identity
# every other phone sees.  See the header note and kcbtinit.sh.
#
# The wait is the deadline: kcbtinit.sh bounds hci_qcomm_init to four seconds so
# it is out of the way before the stack opens the port, and sets
# bluetooth.status either way so the stack does not sit out the timeout.
service kcbtinit /system/bin/sh /system/etc/kcbtinit.sh
    class late_start
    user bluetooth
    group bluetooth net_bt_stack net_bt_admin
    disabled
    oneshot

on property:bluetooth.hciattach=true
    start kcbtinit

on property:bluetooth.hciattach=false
    setprop bluetooth.status off

# The only supplicant in this build.  It pages its network list correctly, so
# the framework's unmodified wifi-service.jar works with it -- see the header.
# -d stays on: it is the only reason the daemon's own view of a command is
# visible at all, and it is what turned this bug from a guess into two lines of
# log.  It costs a few kilobytes in /data/misc/wifi.
service p2p_supplicant /system/bin/wpa_supplicant \
    -ip2p0 -Dnl80211 -c/data/misc/wifi/p2p_supplicant.conf \
    -I/system/etc/wifi/p2p_supplicant_overlay.conf -N \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf \
    -I/system/etc/wifi/wpa_supplicant_overlay.conf \
    -O/data/misc/wifi/sockets -puse_p2p_group_interface=1 \
    -e/data/misc/wifi/entropy.bin -g@android:wpa_wlan0 -d
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

# ---------------------------------------------------------------------------
# Capacitive key backlight: nothing custom owns it any more.
#
# What used to be here was a 630 KB daemon (kcbtnled) that parsed the CMSettings
# provider's SQLite file in-process to follow "button_brightness" /
# "button_backlight_timeout", plus a guard script (kcledguard) that held the
# node at 0 for the first two minutes of uptime and undid whatever else wrote
# to it, plus a deadline script (kcbtnlednet) in case the guard died.
#
# That whole contraption existed because of one symptom: the keys blinked twice
# around the boot animation.  It never removed the blinking -- it moved it, and
# the dumps kept showing one transition the guard could not attribute
# (fix79: "caught v=5 t=59.60 cam= btn=", no daemon running at that second,
# guard dead right after printing it).
#
# The blinking was the debug itself.  The daemon lights the keys to 255 on its
# own start-up and fades them out on its 5 s timeout; the guard forced 0 back
# and the two writes in a row are the two blinks.  With no daemon there is no
# writer, and the node belongs to the framework's lights HAL again -- the same
# HAL whose HMI symbol was fixed in fix78, which is why LightsService now gets
# a device and sets button-backlight itself (fix79 dump: "button: 5 of 255"
# with kcbtnled not yet running).
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# The nodes kcsensor.sh chowns belong to the sensor driver, which probes long
# before init runs, so the work itself is instant; it is the *ordering* that
# matters -- the sensors HAL is constructed by system_server a few seconds
# later, and reads ps_crosstalk in its constructor.
# ---------------------------------------------------------------------------
service kcsensor /system/bin/sh /vendor/bin/kcsensor.sh
    class core
    user root
    group root input
    oneshot
    disabled

# ---------------------------------------------------------------------------
# Pocket mode.
#
# The sensor works (fix82: en=1, "SFH7776 Proximity Sensor: last 10 events",
# 4 = nothing in front, 0..2 = covered).  What does not work is the framework
# end: on this branch PowerManagerService.runWithProximityCheck() is only
# reached from PowerManager.wakeUpWithProximityCheck(), and services.jar calls
# that from exactly one place --
#
#     PhoneWindowManager.wakeUp(..., event.getKeyCode() == KEYCODE_WAKEUP)
#
# -- so the CM "proximity_on_wake" setting can never veto the *power* key:
# wakeUpFromPowerKey() passes false.  Patching that means patching the dex in
# services.jar, and this ROM is "boot image only" (/system/framework/*.jar are
# 299-byte stubs, every class is precompiled in boot.art/boot-*.oat), so a
# changed dex invalidates the image with nothing to fall back to.
#
# So the decision is made in front of the framework instead: kcprox grabs the
# power key's evdev node while the screen is off and drops the press when the
# proximity sensor says the phone is covered.  See kcprox.c.  Nothing is touched
# while the screen is on, and the grab is fd-bound, so this cannot leave the
# power key dead -- if the daemon exits, the kernel releases it.
# ---------------------------------------------------------------------------
service kcprox /vendor/bin/kcprox
    class late_start
    user root
    group root system input
    disabled

# ---------------------------------------------------------------------------
# /dev/fuse does not exist: the kernel has FUSE built in (no uevent) and the
# ramdisk ueventd.rc has no static entry for it.  Create it before vold tries
# to bring up /storage/emulated/0, otherwise /sdcard stays empty forever.
# ---------------------------------------------------------------------------
on post-fs-data
    # See the long note above the kcadsp service: this is the earliest hook
    # that can work (4.70 s, right after /firmware is mounted at 4.688), and it
    # blocks for the ~0.5 s the load takes, which is exactly what we want.
    write /sys/kernel/boot_adsp/boot 1

    # This file is parsed from /system/etc/init, which init only reads once
    # /system is mounted -- that happens *after* the "init" trigger, so an
    # on-init export here would never run.  post-fs-data is the last trigger
    # before "boot", which is where class_start core/main (zygote, mediaserver,
    # audioserver) happens, so everything spawned from here on inherits it.
    export LD_PRELOAD /vendor/lib/libkccabi.so

    # A NULL deref inside cfg80211 must not take the whole phone down.  The
    # kernel has panic_on_oops=1 (Kyocera set it so ramdump would catch every
    # oops); with it every prima teardown turns into a reboot loop.  Let the
    # oops kill the offending thread instead, and keep the log we need.
    write /proc/sys/kernel/panic_on_oops 0

    # PRODUCT_COPY_FILES in the device makefile installs everything 0644, so
    # the helpers arrive without the execute bit on a ROM built from source
    # (the images shipped during bring-up were built by hand and already had
    # it).  Set it here, before any of them is exec'd or started below.  On a
    # hand-built image this is a no-op.
    chmod 0755 /vendor/bin/kcwifi /vendor/bin/kcboot
    chmod 0755 /vendor/bin/kcfuse.sh /vendor/bin/kcssr.sh /vendor/bin/kcadsp.sh
    chmod 0755 /vendor/bin/kctail.sh /vendor/bin/kcshut.sh /vendor/bin/kchalt.sh
    chmod 0755 /vendor/bin/kcstate.sh /vendor/bin/kcstate-boot.sh
    chmod 0755 /vendor/bin/kcstate-delay.sh /vendor/bin/kc_bootanim.sh
    chmod 0755 /vendor/bin/kccam.sh /system/etc/kcfix.sh
    chmod 0755 /system/etc/kcbt.sh
    chmod 0755 /system/etc/kcbtinit.sh
    chmod 0755 /system/bin/btnvtool /system/bin/hci_qcomm_init
    chmod 0755 /vendor/bin/kcsensor.sh
    chmod 0755 /vendor/bin/kcprox

    # Hand the sensor driver's attributes to the sensors HAL (see the header of
    # kcsensor.sh).  Stock did this from /init.rc and /init.kc.sensor.sh; our
    # ramdisk is CM's and has neither, and that one missing chown is why the
    # light and proximity sensors have never worked: the HAL runs inside
    # system_server as uid 1000, sfh7776.c publishes the attributes as 0660
    # root:root, so activate() got EACCES, the driver was never told to sample,
    # and the HAL constructor's failing reads cost 24 s of every boot.
    start kcsensor

    # This phone's Bluetooth core lives inside the WCNSS and is reached over two
    # shared-memory channels, not over a UART.  The stack picks its HCI back end
    # from this property; unset means "default", which means the one-descriptor
    # UART back end, which cannot work here.  See the header note.
    setprop qcom.bluetooth.soc smd

    # hci_qcomm_init (the stock tool that programs the controller, see
    # kcbtinit.sh) picks its port from this one; unset means /dev/ttyHS0.
    setprop ro.qualcomm.bt.hci_transport smd

    # PackageManager has not started yet, so whatever this writes is what it
    # will load.  See the note at the boot_completed trigger.
    exec -- /system/etc/kcbt.sh pre

    exec -- /vendor/bin/kcfuse.sh
    exec -- /vendor/bin/kcboot mknod
    mkdir /data/misc/wifi 0770 wifi wifi
    # QMI transport nodes.  This kernel has CONFIG_DEVTMPFS=n, so they come
    # from ueventd.qcom.rc with the 4.4 ownership; qmuxd runs as radio and
    # fails with "qmi_qmux_if_pwr_up_init failed rc=-1" unless it can open
    # them, which leaves every RIL request unanswered.  (This was once blamed
    # for the baseband showing as unknown -- that one was rild.libargs losing
    # its device path in the makefile, see the telephony note in
    # lineage-common.mk.)
    chown radio radio /dev/qmi0
    chown radio radio /dev/qmi1
    chown radio radio /dev/qmi2
    chmod 0660 /dev/qmi0
    chmod 0660 /dev/qmi1
    chmod 0660 /dev/qmi2
    chown radio radio /dev/smdcntl0
    chown radio radio /dev/smdcntl1
    chmod 0660 /dev/smdcntl0
    chmod 0660 /dev/smdcntl1

    # persist.radio.adb_log_on (qcril's hex dump of the messages it sends) is
    # NOT set here.  A setprop in this section does nothing: post-fs-data runs
    # before load_persist_props_action, so init then loads /data/property and
    # the value on disk -- normally 0 -- overwrites this one.  Measured on the
    # device: the property read back as 0 on every boot that had this line.
    # Set it once by hand instead, and it survives because setprop writes
    # /data/property/persist.radio.adb_log_on:
    #     adb shell setprop persist.radio.adb_log_on 1
    #     adb reboot
    #     adb shell setprop persist.radio.adb_log_on 0
    # It is very verbose, so leave it off except while chasing a QMI message.

    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/audio 0770 audio audio

    # Nothing in this build touches wpa_supplicant.conf or networkHistory.txt.
    # A network written by a script is a network the framework cannot manage,
    # and the saved list is the framework's data, not ours.
    #
    # What is left in kcfix.sh is one system setting:
    #   - captive_portal_mode=IGNORE, because on 7.1 a single failed internet
    #     probe permanently disables a network (threshold 1, timeout
    #     MAX_VALUE) and the gstatic probe cannot succeed from a CN network.
    exec -- /system/bin/sh /system/etc/kcfix.sh

    # The jar below was put back to the build system's own copy (see the
    # header).  Its dex checksum differs from the one ART cached, so it would
    # be recompiled anyway; removing the stale oat makes that certain rather
    # than likely, and costs one line.
    exec -- /system/bin/rm -f /data/dalvik-cache/arm/system@framework@wifi-service.jar@classes.dex
    exec -- /system/bin/rm -f /data/dalvik-cache/system@framework@wifi-service.jar@classes.dex

    # Both of these are declared as services further up.  They have to be
    # started by name: this file is parsed at 4.3 s, long after init has already
    # run class_start core, so a plain "class core" service added here would
    # never run at all -- which is exactly what happened to kcssr in fix23.
    start kcssr
    start kcadsp


    # /cache is where every one of these scripts leaves its transcript, and
    # the bluetooth process (uid 1002) needs to be able to write next to it.
    chmod 0777 /cache

# ---------------------------------------------------------------------------
# Health report for the subsystems that are still broken (key-light settings,
# WiFi, audio, camera, baseband).  Runs at boot_completed and again two minutes
# later, because the supplicant / audio HAL only fail once the framework is up.
# Writing to /cache alone is not enough: the user's dump of that partition is
# truncated, so every line is also pushed to /dev/kmsg ("KCST ...") and
# therefore survives on the log partition.
# ---------------------------------------------------------------------------
# Runs on a timer from late_start; sys.boot_completed is far too late here.
# Watches for the shutdown and records how far the kernel got.  See kcshut.sh.
# ---------------------------------------------------------------------------
# fix28: keep the tail of logcat, not the head.
#
# kcrec stops at 1 MB (~75 s into the boot); the settings freeze happened at
# 74 s and its aftermath -- the watchdog kill of system_server, the audioserver
# respawn loop -- was past the end of the file.  kctail keeps only the tags
# that explain a hang, in five rotating 192 KB files, so the last ten minutes
# before a freeze always survive.  See kctail.sh.
# ---------------------------------------------------------------------------
service kctail /vendor/bin/kctail.sh
    seclabel u:r:init:s0
    class late_start
    user root
    group root system log

service kcshut /vendor/bin/kcshut.sh
    seclabel u:r:init:s0
    class late_start
    user root
    group root system
    oneshot

# Mirrors the camera open/preview transitions into the kernel log, which is the
# only channel a dump always carries in full.  See kccam.sh.


# ---------------------------------------------------------------------------
# Reboot that finishes.
#
# The framework sets sys.shutdown.requested the moment the user picks Reboot or
# Power off; sys.powerctl follows a few seconds later, once userspace is done.
# Up to fix28 the kernel then took over and sat there for eight minutes waiting
# for a modem that is permanently resetting itself.  kchalt.sh waits for
# sys.powerctl and then pulls the sysrq lever, which is the same shortcut a long
# power-press takes: emergency_restart(), with no subsystem stop to wait for.
# See kchalt.sh.
# ---------------------------------------------------------------------------
# Declared as a service, not run with "exec": init blocks until an exec'd
# child exits, and that would stall init's property socket -- including the
# sys.powerctl the framework is about to write, which is exactly what kchalt
# has to see.  As a service it runs beside init and the property goes through.
service kchalt /vendor/bin/kchalt.sh
    seclabel u:r:init:s0
    class late_start
    user root
    group root system
    oneshot
    disabled

on property:sys.shutdown.requested=*
    start kchalt

service kcstate /vendor/bin/kcstate-boot.sh
    seclabel u:r:init:s0
    class late_start
    user root
    group root system
    oneshot

# ---------------------------------------------------------------------------
# Board diagnostics.  kcboot is a static binary because the shell probe that
# came before it started but never produced a single line: this kernel has
# CONFIG_DEVTMPFS=n, the stock ueventd.rc has no /dev/kmsg, and every write
# went to /dev/null.  kcboot creates /dev/kmsg itself *and* writes the same
# transcript to /cache/kc_diag.txt, because the kernel log capture drops
# bursts.  Runs twice: once at boot and once when the framework says it is
# done, so the LED/UIO/storage state can be compared.
# ---------------------------------------------------------------------------
service kcdiag /vendor/bin/kcboot diag
    seclabel u:r:init:s0
    class core
    user root
    group root system
    oneshot

service kcdiag2 /vendor/bin/kcboot diag2
    seclabel u:r:init:s0
    class late_start
    user root
    group root system
    oneshot
    disabled

# fix47: the kcprobe/wpaq pair is gone.  It existed to answer one question --
# what does the daemon reply to SET_NETWORK -- and it answered it.  With Wi-Fi
# working and nothing writing the config, there is nothing left for it to watch,
# and a probe that runs on every boot is just another thing that can fail.
# ---------------------------------------------------------------------------
